# ── Kenya HIE / Shared Health Record ────────────────────────────────────────
# Copy the lines you need into .env (which is gitignored and never committed).
# Nothing here is a real credential.
#
# Paths and the token endpoint below follow the published Postman collection,
# "HIE Integrations UAT API":
#   https://documenter.getpostman.com/view/39260559/2sB3dSPoWf

# The UAT (test) environment, as published at afyaconnect.dha.go.ke/hie-api/auth.
# Verified reachable: its token and SHR routes answer 401 rather than 404. Do NOT point this at production while testing:
# POST /shr/bundles writes to the national clinical record, and a consent
# request sends a real OTP to a real phone.
HIE_BASE=https://ilm-dev.dha.go.ke

# Every HIE route sits under this, including the token endpoint.
HIE_API_PREFIX=/uat-middleware/api/v1

# Your facility's Facility Registry (FR) code — needed for consent and for
# looking up open visits.
HIE_FACILITY_CODE=

# --- Option A: paste a token from Postman for a quick first call ---
# Takes precedence over the client pair below. Expires, so it is for trying a
# call by hand, not for running the service.
HIE_AUTH_TOKEN=

# --- Option B: client credentials (how it should actually run) ---
# POSTed form-encoded to {HIE_BASE}{HIE_API_PREFIX}/tenants/token as exactly
# client_id and client_secret — there is no grant_type. The client keeps the
# token until a minute before it expires.
HIE_CLIENT_ID=
HIE_CLIENT_SECRET=
# Only if the token endpoint is somewhere other than the path above.
HIE_TOKEN_URL=

# Optional. Where the SHR should report the outcome of an asynchronous bundle
# write; sent as the X-HIE-Callback header.
HIE_CALLBACK_URL=
