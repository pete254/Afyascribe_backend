# ── Kenya HIE / Shared Health Record ────────────────────────────────────────
# Copy the lines you need into .env (which is gitignored and never committed).
# Nothing here is a real credential.

# The sandbox base URL from afyaconnect. Do NOT point this at production while
# testing: POST /shr/bundles writes to the national clinical record, and a
# consent request sends a real OTP to a real patient's phone.
HIE_BASE=https://sandbox.example.dha.go.ke

# Your facility's Facility Registry (FR) code — needed to look up open visits.
HIE_FACILITY_CODE=

# --- Option A: paste a token from Postman for a quick first call ---
# Takes precedence over the client pair below. Expires, so it is for trying a
# call by hand, not for running the service.
HIE_AUTH_TOKEN=

# --- Option B: OAuth 2.0 client credentials (how it should actually run) ---
# The client fetches a token and keeps it until a minute before it expires.
HIE_CLIENT_ID=
HIE_CLIENT_SECRET=
# Only if the token endpoint is not {HIE_BASE}/oauth2/token
HIE_TOKEN_URL=
# Only if the sandbox requires an explicit scope
HIE_SCOPE=
