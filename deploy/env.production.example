# Production settings for the Kenyan VPS. Copy to the repository root as .env:
#
#   cp deploy/env.production.example .env && chmod 600 .env
#
# then fill in every blank. Copy secret VALUES from the Render dashboard
# (Environment tab) rather than inventing new ones where noted — a new
# JWT_SECRET, for instance, signs everyone out, which is fine at cutover but
# worth knowing.
#
# .env is git-ignored and must stay that way. Never paste it into chat,
# a ticket or a screenshot.
#
# NODE_ENV, PORT, DB_HOST, DB_PORT, DB_SSL and TRUST_PROXY are set in
# docker-compose.yml and need not appear here.

# ── Database (Postgres in Docker on this server) ────────────────────────────
DB_USERNAME=afyascribe
# Generate: openssl rand -base64 33 | tr -d '/+=' | head -c 40
DB_PASSWORD=
DB_DATABASE=afyascribe

# ── Addresses ──────────────────────────────────────────────────────────────
# Where staff use the web app. Drives the CORS allow-list and links in emails.
FRONTEND_URL=https://app.afyascribe.co.ke
# Where the API answers. Shown in the API documentation.
PUBLIC_API_URL=https://api.afyascribe.co.ke

# ── Sessions ───────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=
AUTH_SESSION_MINUTES=60

# ── Platform bootstrap (spent — the super_admin exists; leave blank) ───────
BOOTSTRAP_SECRET=

# ── Third parties (copy from Render) ───────────────────────────────────────
# Email: sign-in codes, password resets, appointment confirmations.
RESEND_API_KEY=
# Dictation transcription and proofreading.
GROQ_API_KEY=
# Uploaded documents and logos are kept on this server, in the `uploads`
# volume (docker-compose.yml). Links to them are built on this address.
PUBLIC_API_URL=https://api.afyascribe.co.ke

# ── National terminology service ───────────────────────────────────────────
KNHTS_API_BASE=

# ── Kenya HIE / Shared Health Record (see .env.hie.example) ────────────────
HIE_BASE=
HIE_API_PREFIX=
HIE_FHIR_BASE=
HIE_TOKEN_URL=
HIE_CLIENT_ID=
HIE_CLIENT_SECRET=
HIE_AUTH_TOKEN=
# The HIE calls back here. Copy Render's value and change only the host to
# api.afyascribe.co.ke — the path stays the same — and tell DHA if they
# registered the old address.
HIE_CALLBACK_URL=

# ── Surveillance and quality submission endpoints (copy from Render) ───────
IDSR_ALERT_URL=
IDSR_ALERT_TOKEN=
IDSR_WEEKLY_URL=
QUALITY_SUBMIT_URL=
QUALITY_SUBMIT_TOKEN=

# ── Optional ───────────────────────────────────────────────────────────────
# A larger heap than Render's 512 MB instance allowed, if the VPS has room.
# NODE_OPTIONS=--max-old-space-size=1024
