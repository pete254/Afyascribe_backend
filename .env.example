# AfyaScribe backend — environment template.
# Copy to .env and fill in. NEVER commit real values (.env is gitignored).

# ── Database (Postgres / Neon) ────────────────────────────────────────────────
DB_DATABASE=
DB_HOST=
DB_PASSWORD=
DB_PORT=5432
DB_USERNAME=

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
FRONTEND_URL=
JWT_SECRET=

# ── Third-party services ──────────────────────────────────────────────────────
GROQ_API_KEY=
RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── KNHTS terminology service (Kenya Digital Health Authority) ─────────────────
# Open Concept Lab REST API. Blank = default https://ilm-hie.dha.go.ke/ocl
KNHTS_API_BASE=

# ── National HIE / Shared Health Record (FHIR) ────────────────────────────────
# HAPI FHIR R4B server. Blank = default https://fhir.dha.go.ke/fhir
HIE_FHIR_BASE=
# Bearer token for submitting to the HIE. REQUIRED before POST /fhir/Patient/:id/$submit
# will work — obtain from the DHA once credentials / a sandbox are issued.
HIE_AUTH_TOKEN=

# ── WHO ICD API (offline fetch scripts only, not used at runtime) ─────────────
# Free account at https://icd.who.int/icdapi — used by scripts/fetch-icd11-codes.ts
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=

# ── FHIR code-system / identifier URI overrides (optional) ────────────────────
# Blank = built-in defaults (see src/fhir/fhir-systems.ts). Override to match the
# DHA outpatient FHIR IG (afyalink.dha.go.ke) once its canonical URLs are confirmed.
# Defaults:
#   FHIR_SYS_ICD11       http://id.who.int/icd/release/11/mms
#   FHIR_SYS_LOINC       http://loinc.org
#   FHIR_SYS_HPT         <KNHTS_API_BASE>/orgs/MOH-PPB/sources/HPT
#   FHIR_SYS_ICHI        <KNHTS_API_BASE>/orgs/WHO/sources/ICHI
#   FHIR_SYS_MRN         https://afyascribe.health/identifier/mrn
#   FHIR_SYS_NATIONAL_ID https://dha.go.ke/identifier/national-id
#   FHIR_SYS_SHA         https://sha.go.ke/identifier/beneficiary
#   FHIR_SYS_FACILITY    https://kmhfl.health.go.ke/identifier/facility-code
FHIR_SYS_ICD11=
FHIR_SYS_LOINC=
FHIR_SYS_HPT=
FHIR_SYS_ICHI=
FHIR_SYS_MRN=
FHIR_SYS_NATIONAL_ID=
FHIR_SYS_SHA=
FHIR_SYS_FACILITY=
